# ---------------------------------------------------------------------------
# Garidekho environment configuration — copy to .env.local and fill in values
# ---------------------------------------------------------------------------

# Database (PostgreSQL 14+; use a pooled connection string in production)
# Hostinger: use the PostgreSQL database credentials (phpMyAdmin is MySQL-only).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garidekho?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/garidekho?schema=public"
# Used only by `node scripts/dev-db.mjs` (embedded dev PostgreSQL). Must match DATABASE_URL.
PGPORT="5432"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Garidekho"
NEXT_PUBLIC_SUPPORT_PHONE="0339 000 9 333"

# Auth — generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"
SESSION_TTL_DAYS="30"

# Google OAuth (optional — Google login button is disabled without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Email (SMTP) — used for verification and notification emails
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="Garidekho <no-reply@garidekho.com.pk>"

# SMS OTP provider abstraction — "console" for local dev ONLY (returns the OTP in the response)
SMS_PROVIDER="console" # console | webhook | twilio
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="GARIDEKHO"

# Image storage — "local" writes to .uploads and is for development only
# S3_* variables below are reserved placeholders; the s3 driver is not implemented.
STORAGE_DRIVER="local" # local | cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
NEXT_PUBLIC_UPLOAD_MAX_MB="8"

# Redis cache (optional; falls back to in-process cache when absent)
REDIS_URL=""

# Maps — "osm" needs no key; "google" requires NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
NEXT_PUBLIC_MAPS_PROVIDER="osm"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Payment providers — webhook verification requires real credentials in production
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_HASH_KEY=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_IBAN=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_SUCCESS_URL="http://localhost:3000/payments/success"
PAYMENT_FAILURE_URL="http://localhost:3000/payments/failure"

# Cron / background job protection (reserved until scheduled endpoints exist)
CRON_SECRET="replace-with-a-long-random-secret"

# Testing (playwright.config.ts) — E2E defaults to :3100 to avoid clashing with `npm run dev`
E2E_PORT="3100"
E2E_BASE_URL="http://localhost:3100"

# Observability / monitoring (reserved — wire up in your deployment before relying on them)
SENTRY_DSN=""
LOG_LEVEL="info"
